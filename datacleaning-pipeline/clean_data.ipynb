    "#clean each individual directory and join\n",
    "\n",
    "#clean daymet mean forcing - Alex\n",
    "#input:  daymet_dir = path to basin_mean_forcing/daymet/\n",
    "#        hucs = region folders to read, e.g. [\"17\"]\n",
    "#output: DataFrame, one row per gauge per day\n",
    "#        gauge_id (text, from the filename), date (one datetime column), weather columns\n",
    "#note:   each file has 3 header lines before the column names\n",
    "def clean_daymet(daymet_dir, hucs=[\"17\"]):\n",
    "    #Array for accumulating cleaned data\n",
    "    daymet_data = np.empty((0, 8))\n",
    "\n",
    "    #Column names\n",
    "    daymet_data_column_names = [\"gauge_id\", \"date\", \"dayl(s)\", \"prcp(mm/day)\", \"srad(W/m2)\", \"tmax(C)\", \"tmin(C)\", \"vp(Pa)\"]\n",
    "\n",
    "    #Loop through each huc\n",
    "    for huc in hucs:\n",
    "   \n",
    "        #Enter the directory for each huc \"{daymet_mean_forcing_dir}/{huc}\"\n",
    "        huc_dir = f'{daymet_dir}/{huc}'\n",
    "        gauge_file_names = [file for file in os.listdir(huc_dir) if os.path.isfile(os.path.join(huc_dir, file))]\n",
    "        gauge_file_paths = [\n",
    "            os.path.abspath(os.path.join(huc_dir, file))\n",
    "            for file in gauge_file_names\n",
    "        ]\n",
    "        #print(gauge_file_paths)\n",
    "        \n",
    "        #Loop through each file\n",
    "        for i in range(len(gauge_file_paths)):\n",
    "            #Extract gauge ID from filename (split the filename with _ as delimiter and take the first element) and add to dictionary as key\n",
    "            gauge_id = gauge_file_names[i].split(\"_\")[0]\n",
    "            #print(f'gauge_id={gauge_id}')\n",
    "\n",
    "            #Do a readlines operation on the file to collect raw data\n",
    "            f = open(gauge_file_paths[i], \"r\", encoding=\"utf-8\")\n",
    "            gauge_data = f.readlines()\n",
    "            f.close()\n",
    "\n",
    "            #Collect everything except for the first four lines as day-to-day data\n",
    "            gauge_data = gauge_data[4:]\n",
    "\n",
    "            #Strip new lines\n",
    "            gauge_data = [gauge_data_point.rstrip(\"\\n\") for gauge_data_point in gauge_data]\n",
    "\n",
    "            #Split data points with \\t as delimiter\n",
    "            gauge_data = [gauge_data_point.split(\"\\t\") for gauge_data_point in gauge_data]\n",
    "\n",
    "            #Remove hour measurement from date since it's always 12\n",
    "            for data_point in gauge_data:\n",
    "                data_point[0] = data_point[0][:-3]\n",
    "\n",
    "            #Remove SWE (Snow-Water Equivalent) column because it is always 0\n",
    "            gauge_data = np.array(gauge_data)\n",
    "            gauge_data = np.delete(gauge_data, -4, axis=1)\n",
    "            \n",
    "            #Prepend gauge_id to gauge_data\n",
    "            gauge_data = np.insert(gauge_data, 0, gauge_id, axis=1)\n",
    "\n",
    "            #Add to accumulator\n",
    "            daymet_data = np.vstack([daymet_data, gauge_data])\n",
    "            \n",
    "            \n",
    "\n",
    "    print(f'daymet_data.shape={daymet_data.shape}') \n",
    "\n",
    "    #Convert to pandas dataframe to conform to integration standard\n",
    "    daymet_data_df = pd.DataFrame(daymet_data, columns=daymet_data_column_names)      \n",
    "\n",
    "    #Return clean array\n",
    "    return daymet_data_df\n",
    "\n",
    "#clean_daymet(daymet_mean_forcing_dir, hucs=[\"01\"])\n"
   ]
